import sys
import os
sys.path.append(os.path.dirname(os.path.abspath('__file__')))

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from clinical_validation import ClinicalTrialValidator

# Import our existing PK-PD model
from pk_pd_model import PKPDModel

print("🔬 CLINICAL TRIAL VALIDATION - PRODUCTION STEP 1")
print("=" * 60)

# Load the trained model
print("\n📦 Loading trained PK-PD model...")
