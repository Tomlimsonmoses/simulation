"""
This notebook implements the third production step: Disease-specific models
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath('__file__')))

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from disease_specific_models import DiseaseSpecificModeler, DiseaseSeverity

print("🏥 DISEASE-SPECIFIC MODELS - PRODUCTION STEP 3")
print("=" * 60)

# Initialize disease-specific modeler
print("\n📦 Initializing Disease-Specific Modeler...")
disease_modeler = DiseaseSpecificModeler()

# Display disease database summary
print("\n📊 Disease Database Summary:")
summary = disease_modeler.get_disease_database_summary()
for key, value in summary.items():
    print(f"   {key}: {value}")

# Example 1: Assess disease severity from biomarkers
print(f"\n🔬 Example 1: Disease Severity Assessment")
biomarkers = {
    'chronic_kidney_disease': {'gfr': 25, 'creatinine': 2.8},
    'liver_cirrhosis': {'albumin': 2.5, 'bilirubin': 3.8},
    'heart_failure': {'ef': 35, 'bnp': 450}
}

for disease, values in biomarkers.items():
    severity = disease_modeler.assess_disease_severity(disease, values)
    print(f"   {disease}: {severity} severity")

# Example 2: Compare healthy vs disease drug response
print(f"\n💊 Example 2: Healthy vs Disease Drug Response")

# Patient factors
patient_factors = {
    'age': 65,
    'weight': 75,
    'creatinine_clearance': 40,
    'fed': True,
    'route': 'oral'
}

# Define disease states
disease_states = [
    disease_modeler.get_disease_state('chronic_kidney_disease', 'moderate'),
    disease_modeler.get_disease_state('heart_failure', 'mild')
]

# Compare responses
drug_name = 'Lisinopril'
dose = 10  # mg

comparison = disease_modeler.compare_healthy_vs_disease(
    drug_name, dose, patient_factors, disease_states
)

print(f"\n📈 Comparison Results for {drug_name}:")
print(f"   Healthy Peak Concentration: {comparison['healthy']['peak_concentration']:.2f}")
print(f"   Disease Peak Concentration: {comparison['disease']['peak_concentration']:.2f}")
print(f"   Concentration Ratio: {comparison['ratios']['peak_concentration_ratio']:.2f}")
print(f"   Healthy Peak Response: {comparison['healthy']['peak_response']:.2f}")
print(f"   Disease Peak Response: {comparison['disease']['peak_response']:.2f}")
print(f"   Response Ratio: {comparison['ratios']['peak_response_ratio']:.2f}")

# Display recommendations
print(f"\n📋 Clinical Recommendations:")
recommendations = comparison['recommendations']
print(f"   Dose Adjustment: {recommendations['dose_adjustment']}")
print(f"   Monitoring Parameters: {', '.join(recommendations['monitoring_parameters'])}")
print(f"   Precautions: {', '.join(recommendations['precautions'])}")
print(f"   Special Considerations: {', '.join(recommendations['special_considerations'][:3])}...")

# Example 3: Multiple disease states simulation
print(f"\n🔄 Example 3: Multiple Disease States Impact")

# Test different disease combinations
disease_scenarios = [
    {'name': 'Healthy', 'states': []},
    {'name': 'CKD Only', 'states': [disease_modeler.get_disease_state('chronic_kidney_disease', 'moderate')]},
    {'name': 'CKD + Heart Failure', 'states': [
        disease_modeler.get_disease_state('chronic_kidney_disease', 'moderate'),
        disease_modeler.get_disease_state('heart_failure', 'mild')
    ]},
    {'name': 'CKD + Liver Cirrhosis', 'states': [
        disease_modeler.get_disease_state('chronic_kidney_disease', 'moderate'),
        disease_modeler.get_disease_state('liver_cirrhosis', 'moderate')
    ]}
]

time_points = np.linspace(0, 24, 100)
results = {}

for scenario in disease_scenarios:
    if scenario['states']:  # Skip healthy for now (handled separately)
        simulation = disease_modeler.simulate_disease_specific_response(
            drug_name, dose, patient_factors, scenario['states'], time_points
        )
        results[scenario['name']] = simulation

# Add healthy simulation
from expanded_drug_database import ExpandedDrugDatabase
drug_db = ExpandedDrugDatabase()
healthy_sim = drug_db.simulate_drug_response(drug_name, dose, patient_factors, time_points)
results['Healthy'] = {
    'concentrations': healthy_sim['concentrations'],
    'responses': healthy_sim['responses']
}

# Create visualization
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(15, 6))

# PK comparison
for scenario_name, sim in results.items():
    ax1.plot(time_points, sim['concentrations'], label=scenario_name, linewidth=2)

ax1.set_xlabel('Time (hours)')
ax1.set_ylabel('Concentration (mcg/mL)')
ax1.set_title(f'{drug_name} PK Profiles - Disease Impact')
ax1.legend()
ax1.grid(True, alpha=0.3)

# PD comparison
for scenario_name, sim in results.items():
    ax2.plot(time_points, sim['responses'], label=scenario_name, linewidth=2)

ax2.set_xlabel('Time (hours)')
ax2.set_ylabel('Response (%)')
ax2.set_title(f'{drug_name} PD Profiles - Disease Impact')
ax2.legend()
ax2.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('disease_specific_comparison.png', dpi=300, bbox_inches='tight')
plt.show()

# Example 4: Generate comprehensive disease report
print(f"\n📄 Example 4: Comprehensive Disease Impact Report")

# Test with multiple drugs
test_drugs = ['Metformin', 'Atorvastatin', 'Sertraline']
disease_combo = [
    disease_modeler.get_disease_state('chronic_kidney_disease', 'moderate'),
    disease_modeler.get_disease_state('diabetes_mellitus', 'moderate')
]

print(f"\n🏥 Disease Combination: CKD Moderate + Diabetes Moderate")
print(f"📊 Drug Impact Analysis:")

for drug in test_drugs:
    comparison = disease_modeler.compare_healthy_vs_disease(
        drug, 100, patient_factors, disease_combo
    )
    
    print(f"\n   💊 {drug}:")
    print(f"      PK AUC Ratio: {comparison['ratios']['auc_pk_ratio']:.2f}")
    print(f"      PD AUC Ratio: {comparison['ratios']['auc_pd_ratio']:.2f}")
    print(f"      Dose Adjustment: {comparison['recommendations']['dose_adjustment']}")
    print(f"      Key Precautions: {', '.join(comparison['recommendations']['precautions'][:2])}")

# Example 5: Biomarker-based severity assessment
print(f"\n🧪 Example 5: Biomarker-Based Severity Assessment")

test_cases = [
    {'name': 'Patient A', 'biomarkers': {'gfr': 45, 'creatinine': 1.8}},
    {'name': 'Patient B', 'biomarkers': {'gfr': 20, 'creatinine': 3.2}},
    {'name': 'Patient C', 'biomarkers': {'gfr': 8, 'creatinine': 5.5}}
]

for patient in test_cases:
    severity = disease_modeler.assess_disease_severity('chronic_kidney_disease', patient['biomarkers'])
    disease_state = disease_modeler.get_disease_state('chronic_kidney_disease', severity)
    
    print(f"\n   {patient['name']}:")
    print(f"      GFR: {patient['biomarkers']['gfr']} mL/min")
    print(f"      Creatinine: {patient['biomarkers']['creatinine']} mg/dL")
    print(f"      Severity: {severity}")
    print(f"      Clearance Reduction: {disease_state.pk_modifications['clearance_reduction']:.1%}")

print(f"\n✅ Disease-Specific Models Implementation Complete!")
print("=" * 60)

