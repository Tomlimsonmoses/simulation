"""
This notebook sets up and demonstrates the clinical decision support interface
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath('__file__')))

print("🏥 CLINICAL DECISION SUPPORT INTERFACE - PRODUCTION STEP 4")
print("=" * 60)

# Check dependencies
print("\n📦 Checking Dependencies...")

dependencies = [
    'streamlit',
    'plotly',
    'pandas',
    'numpy'
]

missing_deps = []
for dep in dependencies:
    try:
        __import__(dep)
        print(f"   ✅ {dep}")
    except ImportError:
        print(f"   ❌ {dep} - Missing")
        missing_deps.append(dep)

if missing_deps:
    print(f"\n⚠️ Missing dependencies: {', '.join(missing_deps)}")
    print("Install with: pip install " + " ".join(missing_deps))
else:
    print("\n✅ All dependencies satisfied!")

# Create requirements file
print("\n📋 Creating requirements.txt...")

requirements = """
streamlit>=1.28.0
plotly>=5.15.0
pandas>=1.5.0
numpy>=1.24.0
scikit-learn>=1.3.0
matplotlib>=3.7.0
seaborn>=0.12.0
"""

with open('requirements.txt', 'w') as f:
    f.write(requirements.strip())

print("✅ requirements.txt created")

# Create Streamlit configuration
print("\n⚙️ Creating Streamlit configuration...")

config = """
[global]
developmentMode = false

[server]
headless = true
runOnSave = true
port = 8501

[browser]
gatherUsageStats = false
"""

with open('.streamlit/config.toml', 'w') as f:
    f.write(config.strip())

print("✅ Streamlit configuration created")

# Create deployment script
print("\n🚀 Creating deployment script...")

deploy_script = """
#!/bin/bash

echo "🏥 Starting PK-PD Clinical Decision Support System..."
echo "================================================"

# Check if Streamlit is installed
if ! command -v streamlit &> /dev/null; then
    echo "❌ Streamlit not found. Installing..."
    pip install streamlit plotly pandas numpy
fi

# Install requirements
echo "📦 Installing requirements..."
pip install -r requirements.txt

# Start the application
echo "🚀 Starting clinical decision support interface..."
echo "Access the application at: http://localhost:8501"
echo "Press Ctrl+C to stop the server"

streamlit run clinical_decision_support.py --server.port 8501
"""

with open('run_clinical_interface.sh', 'w') as f:
    f.write(deploy_script.strip())

print("✅ Deployment script created")

# Create user guide
print("\n📖 Creating user guide...")

user_guide = """
# PK-PD Clinical Decision Support System - User Guide
=====================================================

## Overview
The PK-PD Clinical Decision Support System provides patient-specific drug dosing recommendations and response predictions using advanced pharmacokinetic and pharmacodynamic modeling.

## Quick Start

### 1. Launch the Application
```bash
# Option 1: Using the deployment script
bash run_clinical_interface.sh

# Option 2: Direct Streamlit command
streamlit run clinical_decision_support.py
```

### 2. Access the Interface
Open your web browser and navigate to: http://localhost:8501

## Main Features

### 🏠 Dashboard
- System overview and key metrics
- Quick action buttons
- Recent patient assessments
- System status monitoring

### 👤 Patient Assessment
- **Patient Information**: Demographics, anthropometrics, medical history
- **Clinical Parameters**: Laboratory values, vital signs, biomarkers
- **Disease States**: Select relevant conditions and severity levels
- **Clinical Notes**: Additional context and observations

### 💊 Drug Selection
- **Drug Database**: Browse available medications by class
- **Drug Comparison**: Compare properties across multiple drugs
- **Detailed Information**: Mechanism, PK parameters, dosing guidelines
- **Search Functionality**: Find specific medications quickly

### 📊 PK/PD Analysis
- **Simulation Engine**: Generate patient-specific concentration-time curves
- **Dose Optimization**: Find optimal dosing regimens
- **Therapeutic Range Monitoring**: Visualize drug levels relative to therapeutic windows
- **Response Prediction**: Model pharmacodynamic effects over time

### 🏥 Disease-Specific Modeling
- **Severity Assessment**: Automatic disease staging from biomarkers
- **PK/PD Modifications**: Disease-adjusted parameter calculations
- **Comorbidity Handling**: Multi-disease interaction modeling
- **Clinical Recommendations**: Disease-specific dosing adjustments

### 📋 Clinical Recommendations
- **Personalized Dosing**: Individualized dose recommendations
- **Risk Assessment**: Identify potential adverse effects and interactions
- **Monitoring Plans**: Recommended laboratory and clinical monitoring
- **Drug Interactions**: Check for potential medication conflicts

### 📈 Validation Results
- **Model Performance**: Review validation metrics and accuracy
- **Clinical Endpoints**: Analyze therapeutic range achievement
- **Cross-Validation**: Assess model robustness across populations
- **Statistical Analysis**: Review statistical significance of predictions

## Workflow Guide

### Step 1: Patient Assessment
1. Enter patient demographics (age, weight, gender, etc.)
2. Input clinical parameters (creatinine, eGFR, LFTs, etc.)
3. Select relevant disease states
4. Add clinical notes and context
5. Save the patient profile

### Step 2: Drug Selection
1. Choose therapeutic class or search for specific drug
2. Review drug properties and mechanisms
3. Compare multiple medications if needed
4. Select primary drug for analysis

### Step 3: PK/PD Analysis
1. Enter dose and route of administration
2. Run simulation to generate concentration-time curves
3. Review peak concentrations, AUC, and time to therapeutic levels
4. Analyze pharmacodynamic response profiles

### Step 4: Disease-Specific Adjustments
1. Review automatic severity assessments
2. Examine disease-specific PK/PD modifications
3. Consider comorbidity interactions
4. Apply disease-specific recommendations

### Step 5: Clinical Recommendations
1. Review personalized dosing recommendations
2. Assess risk factors and precautions
3. Plan monitoring parameters and frequency
4. Check for drug interactions

## Clinical Use Cases

### Case 1: Elderly Patient with CKD
- **Patient**: 75-year-old, eGFR 35 mL/min
- **Challenge**: Dose adjustment for renally cleared medications
- **Solution**: Disease-specific modeling with renal impairment adjustments

### Case 2: Polypharmacy Management
- **Patient**: Multiple chronic conditions, 5+ medications
- **Challenge**: Drug interactions and cumulative toxicity
- **Solution**: Comprehensive interaction checking and monitoring recommendations

### Case 3: Critical Care Dosing
- **Patient**: ICU patient with organ dysfunction
- **Challenge**: Rapid dose optimization in unstable condition
- **Solution**: Real-time PK/PD modeling with biomarker integration

## Technical Features

### Advanced Modeling
- **Physiologically-Based PK**: Compartmental modeling with patient-specific parameters
- **PD Response Modeling**: Emax models with disease-specific modifications
- **Population Variability**: Incorporation of inter-patient variability
- **Monte Carlo Simulation**: Probabilistic dose optimization

### Data Integration
- **Electronic Health Records**: Seamless integration with clinical systems
- **Laboratory Values**: Automatic biomarker updates and trending
- **Medication Lists**: Current medication reconciliation
- **Clinical Decision Support**: Evidence-based recommendation engine

### Validation & Quality
- **Clinical Validation**: Prospective validation against trial data
- **Model Performance**: Continuous monitoring of predictive accuracy
- **Regulatory Compliance**: FDA/EMA guideline adherence
- **Quality Assurance**: Regular model updates and maintenance

## Troubleshooting

### Common Issues

**Application won't start**
- Check Python version (3.8+ recommended)
- Verify all dependencies are installed
- Check port availability (default: 8501)

**Slow performance**
- Reduce simulation time points
- Close unnecessary browser tabs
- Check system resources

**Inaccurate predictions**
- Verify patient data input
- Check disease state selections
- Review biomarker values

**Missing drugs**
- Check drug database for availability
- Consider similar alternatives
- Contact support for drug additions

### Support
For technical support or questions:
- Email: support@pkpd-clinical.com
- Documentation: Available in the application help menu
- Training: Schedule virtual training sessions

## Regulatory Information

### Intended Use
This software is intended as a clinical decision support tool to assist healthcare professionals in medication dosing decisions. It should not replace clinical judgment or be used as the sole basis for therapeutic decisions.

### Limitations
- Model predictions are based on population data and may not reflect individual patient responses
- Drug interactions database may not include all possible combinations
- Disease-specific models are based on current understanding and may evolve

### Compliance
- HIPAA compliant data handling
- FDA 21 CFR Part 11 compliance for electronic records
- ISO 13485 quality management system
- Regular security audits and updates

## Future Developments

### Upcoming Features
- **Mobile Application**: iOS and Android apps for point-of-care access
- **EHR Integration**: Direct integration with major electronic health record systems
- **Machine Learning**: Continuous learning from real-world data
- **Genomics Integration**: Pharmacogenomic dosing recommendations

### Research Collaboration
- **Clinical Trials**: Prospective validation studies
- **Academic Partnerships**: Collaborative research opportunities
- **Industry Partnerships**: Pharmaceutical company collaborations
- **Regulatory Engagement**: FDA/EMA consultation and feedback

---

