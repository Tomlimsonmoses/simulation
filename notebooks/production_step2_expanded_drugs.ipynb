# Production Implementation Plan - Expanded Drug Classes
# ====================================================

"""
This notebook implements the second production step: Expand to more drug classes
"""

import sys
import os
sys.path.append(os.path.dirname(os.path.abspath('__file__')))

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from expanded_drug_database import ExpandedDrugDatabase

print("💊 EXPANDED DRUG CLASSES - PRODUCTION STEP 2")
print("=" * 60)

# Initialize expanded drug database
print("\n📦 Initializing Expanded Drug Database...")
drug_db = ExpandedDrugDatabase()

# Display database summary
print("\n📊 Database Summary:")
summary = drug_db.get_database_summary()
for key, value in summary.items():
    print(f"   {key}: {value}")

# Show available drug classes
print(f"\n💉 Available Drug Classes:")
for i, (class_name, drugs) in enumerate(drug_db.drug_classes.items(), 1):
    print(f"   {i}. {class_name}: {', '.join(drugs)}")

# Example: Compare drugs within a class
print(f"\n🔍 Comparing Cardiovascular Drugs...")
cardio_drugs = drug_db.get_drugs_by_class('Cardiovascular')
print(f"   Drugs: {', '.join(cardio_drugs)}")

# Patient factors for comparison
patient_factors = {
    'age': 65,
    'weight': 80,
    'disease': 'hypertension',
    'creatinine_clearance': 70,
    'fed': True,
    'route': 'oral'
}

# Generate comparison report
comparison = drug_db.generate_drug_comparison_report(cardio_drugs, patient_factors)

print(f"\n📈 Cardiovascular Drug Comparison:")
for drug_name, results in comparison.items():
    print(f"\n   {drug_name}:")
    print(f"      Peak Concentration: {results['peak_concentration']:.2f}")
    print(f"      Peak Response: {results['peak_response']:.2f}")
    print(f"      Time to Peak: {results['time_to_peak']:.1f} hours")
    print(f"      Duration Above Therapeutic: {results['duration_above_therapeutic']:.1f} hours")

# Simulate time course for a specific drug
print(f"\n⏰ Simulating Lisinopril Time Course...")
time_points = np.linspace(0, 24, 100)
simulation = drug_db.simulate_drug_response('Lisinopril', 10, patient_factors, time_points)

# Create visualization
fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8))

# PK plot
ax1.plot(time_points, simulation['concentrations'], 'b-', linewidth=2)
ax1.axhline(y=simulation['drug_properties']['therapeutic_range'][0], 
               color='g', linestyle='--', alpha=0.7, label='Therapeutic Min')
ax1.axhline(y=simulation['drug_properties']['therapeutic_range'][1], 
               color='r', linestyle='--', alpha=0.7, label='Therapeutic Max')
ax1.set_xlabel('Time (hours)')
ax1.set_ylabel('Concentration (mcg/mL)')
ax1.set_title('Lisinopril Pharmacokinetic Profile')
ax1.legend()
ax1.grid(True, alpha=0.3)

# PD plot
ax2.plot(time_points, simulation['responses'], 'r-', linewidth=2)
ax2.set_xlabel('Time (hours)')
ax2.set_ylabel('Response (%)')
ax2.set_title('Lisinopril Pharmacodynamic Response')
ax2.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('expanded_drug_simulation.png', dpi=300, bbox_inches='tight')
plt.show()

# Export expanded database
print(f"\n💾 Exporting Expanded Drug Database...")
drug_db.export_database('expanded_drug_database.json')

print(f"\n✅ Expanded Drug Classes Implementation Complete!")
print("=" * 60)

# Test cross-class comparison
print(f"\n🔄 Cross-Class Drug Comparison:")
test_drugs = ['Acetaminophen', 'Lisinopril', 'Metformin', 'Sertraline']
cross_comparison = drug_db.generate_drug_comparison_report(test_drugs, patient_factors)

for drug_name, results in cross_comparison.items():
    print(f"\n   {drug_name} ({results['properties']['class']}):")
    print(f"      Peak Response: {results['peak_response']:.2f}")
    print(f"      Response AUC: {results['auc_pd']:.2f}")
    print(f"      Half-life: {results['simulation']['pk_parameters']['half_life']:.1f} hours")

print(f"\n🎯 Production Step 2 Complete: Expanded to {len(drug_db.get_all_drug_names())} drugs across {len(drug_db.get_all_drug_classes())} classes!")
